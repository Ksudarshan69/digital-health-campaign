# Copy this file to .env and fill in real values. Never commit .env itself.

# Django
SECRET_KEY=change-this-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Database (PostgreSQL)
DB_NAME=digital_health_campaign
DB_USER=dhc_user
DB_PASSWORD=change-this-password
DB_HOST=127.0.0.1
DB_PORT=5432

# Media storage (leave blank for local storage during development)
USE_S3=False
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=

# Email (for contact form notifications, optional)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
